{
  "name": "spyder-client",
  "version": "1.0.8",
  "description": "Launcher Oficial de Spyder Studios",
  "main": "main.js",
  "author": "Spyder Studios",
  "repository": {
    "type": "git",
    "url": "https://github.com/Danxx0504/updateslauncher.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-updater": "^6.8.9",
    "firebase": "^12.0.0",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.falcomstudio.falcomclient",
    "productName": "Spyder Client",
    "asar": true,
    "files": [
      "main.js",
      "index.html",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/logodelauncher.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "Danxx0504",
      "repo": "updateslauncher",
      "releaseType": "release"
    }
  }
}